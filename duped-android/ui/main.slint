import {
    MaterialWindow,
    AppBar,
    FilledButton,
    IconButton,
    MaterialPalette,
} from "@material";

export component MainWindow inherits MaterialWindow {
    callback scan_downloads();
    callback scan_parent();
    callback scan_root();
    in-out property <bool> scanning_parent: false;
    in-out property <bool> scanning_root: false;
    in-out property <bool> scanning_downloads: false;
    in-out property <int> files_count: 0;
    in-out property <[string]> files_list: [];

    property <bool> drawer-open: false;
    property <length> drawer-width: 320px;

    title: "Duped";
    disable-hover: true;

    // Full-window shell.
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        // Match the system-bar area to the AppBar background.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.safe-area-insets.top;
            background: MaterialPalette.primary;
        }

        app-bar := AppBar {
            x: 0px;
            y: root.safe-area-insets.top;
            width: parent.width;
            height: 56px;

            title: "Duped";
            show-background: true;

            leading-button: {
                icon: @image-url("icons/menu.svg"),
                tooltip: "Open menu",
                enabled: true,
            };

            leading-button-clicked => {
                root.drawer-open = true;
            }
        }

        Rectangle {
            x: 0px;
            y: app-bar.y + app-bar.height;
            width: parent.width;
            height: parent.height - self.y;
            background: transparent;

            VerticalLayout {
    spacing: 16px;
    width: parent.width;
    height: parent.height;
    alignment: center;
    
    Text {
        text: "Files found: " + files_count;
        horizontal-alignment: center;
    }
    FilledButton {
        text: scanning_downloads ? "Scanning..." : "Scan Downloads";
        enabled: !scanning_downloads && !scanning_parent && !scanning_root;
        clicked => { scan_downloads(); }
    }
    FilledButton {
        text: scanning_parent ? "Scanning..." : "Scan Parent";
        enabled: !scanning_parent && !scanning_downloads && !scanning_root;
        clicked => { scan_parent(); }
    }
    FilledButton {
        text: scanning_root ? "Scanning..." : "Scan Root";
        enabled: !scanning_root && !scanning_downloads && !scanning_parent;
        clicked => { scan_root(); }
    }
    Flickable {
        width: parent.width - 32px;
        height: 180px;
        content-height: files_list.length * 24px;
        Rectangle {
            width: parent.width - 32px;
            height: files_list.length * 24px;
            VerticalLayout {
                for file in files_list : Text {
                    text: file;
                    font-size: 14px;
                }
            }
        }
    }
}
        }
    }

    // Edge swipe area.
    TouchArea {
        x: 0px;
        y: root.safe-area-insets.top;
        width: 32px;
        height: parent.height - root.safe-area-insets.top;

        moved => {
            if (!root.drawer-open && self.pressed && self.mouse-x > 64px) {
                root.drawer-open = true;
            }
        }
    }

    // Scrim is only present while the drawer is open.
    if root.drawer-open : TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000080;
        }

        clicked => {
            root.drawer-open = false;
        }
    }

    // Drawer is an overlay outside the app shell.
    Rectangle {
        width: root.drawer-width;
        height: parent.height;
        x: root.drawer-open ? 0px : -self.width;
        background: #fffbff;
        clip: true;

        animate x {
            duration: 220ms;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 64px;
            background: #f3edf7;

            Text {
                x: 24px;
                y: (parent.height - self.height) / 2;
                text: "Duped";
                font-size: 22px;
                font-weight: 600;
                color: #1d192b;
            }

            IconButton {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/close.svg");
                tooltip: "Close menu";

                clicked => {
                    root.drawer-open = false;
                }
            }
        }

        VerticalLayout {
            x: 0px;
            y: 64px;
            width: parent.width;
            height: parent.height - 64px;
            padding-left: 24px;
            padding-top: 24px;
            spacing: 16px;

            Text {
                text: "Navigation";
                color: #49454f;
                font-size: 14px;
            }

            Text {
                text: "Duplicate finder";
                color: #1d192b;
                font-size: 16px;
            }
        }

        // Consume touches on the drawer panel.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }
}
