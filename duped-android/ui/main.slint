import {
    MaterialWindow,
    AppBar,
    FilledButton,
    IconButton,
} from "@material";

export component MainWindow inherits MaterialWindow {
    in-out property <int> count: 0;
    property <bool> drawer-open: false;
    property <length> drawer-width: 320px;

    title: "Duped";
    disable-hover: true;

    // Main app shell: app bar at the top, content fills the rest.
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        app-bar := AppBar {
            width: parent.width;
            title: "Duped";
            show-background: true;

            leading-button: {
                icon: @image-url("icons/menu.svg"),
                tooltip: "Open menu",
                enabled: true,
            };

            leading-button-clicked => {
                root.drawer-open = true;
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height - app-bar.height;
            background: transparent;

            FilledButton {
                text: "Count: " + root.count;
                icon: @image-url("slint-logo.svg");
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                clicked => {
                    root.count += 1;
                }
            }
        }
    }

    // Edge swipe area. Kept outside the shell layout so it overlays it.
    TouchArea {
        width: 32px;
        height: parent.height;

        moved => {
            if (!root.drawer-open && self.pressed && self.mouse-x > 64px) {
                root.drawer-open = true;
            }
        }
    }

    // Scrim overlays the app and closes the drawer when tapped.
    if root.drawer-open : TouchArea {
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000080;
        }

        clicked => {
            root.drawer-open = false;
        }
    }

    // Drawer overlays the shell. It starts off-screen when closed.
    Rectangle {
        width: root.drawer-width;
        height: parent.height;
        x: root.drawer-open ? 0px : -self.width;
        background: #fffbff;
        clip: true;

        animate x {
            duration: 220ms;
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                width: parent.width;
                height: 64px;
                background: #f3edf7;

                Text {
                    x: 24px;
                    y: (parent.height - self.height) / 2;
                    text: "Duped";
                    font-size: 22px;
                    font-weight: 600;
                    color: #1d192b;
                }

                IconButton {
                    x: parent.width - self.width - 12px;
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/close.svg");
                    tooltip: "Close menu";

                    clicked => {
                        root.drawer-open = false;
                    }
                }
            }

            VerticalLayout {
                width: parent.width;
                padding-left: 24px;
                padding-top: 24px;
                spacing: 16px;

                Text {
                    text: "Navigation";
                    color: #49454f;
                    font-size: 14px;
                }

                Text {
                    text: "Duplicate finder";
                    color: #1d192b;
                    font-size: 16px;
                }
            }
        }

        // Keep drawer taps from reaching the scrim.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }
}
